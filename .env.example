# ===== Môi trường chạy =====

FOX_ENV=dev
FOX_LOG_DIR=var

# ===== Mô hình ngôn ngữ (điền khi tích hợp; để trống thì phần sinh câu trả lời chạy chế độ giả lập) =====

FOX_LLM_PROVIDER=
FOX_LLM_BASE_URL=
FOX_LLM_API_KEY=
FOX_LLM_MODEL=

# ===== CORS cho frontend khi phát triển =====

FOX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== FOX-Guard (Phần B) =====

# Model Hugging Face lưu trên ổ D (ổ C gần đầy). Luôn dùng dạng D:/..., không dùng /d/...
HF_HOME=D:/create/DATN/FOX-Guardrails/.cache/hf
# Token HF chỉ cần sau khi chủ đồ án tự chấp nhận license Llama Prompt Guard 2. Không commit.
HF_TOKEN=
# Đường dẫn file cấu hình
FOX_CONFIG=fox-guard.yaml
# Salt để băm user_id trong audit (B6.5). Sinh ngẫu nhiên, không commit giá trị thật.
FOX_AUDIT_SALT=
# Khoá tĩnh cho header X-FOX-Key của sidecar (B7)
FOX_API_KEY=
